{
  "name": "rowvane",
  "version": "1.0.0",
  "description": "A visual PostgreSQL workspace combining spreadsheet-style browsing, SQL execution, and CSV import/export.",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "node --watch --env-file-if-exists=.env index.js",
