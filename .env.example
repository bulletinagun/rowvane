# =============================================================================
# Rowvane — Environment Configuration Template
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# =============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL Connection Configuration
# Option 1: Full connection URI (Render, Railway, Neon, Supabase, Docker)
DATABASE_URL=postgresql://localhost:5432/rowvane

# Option 2: Discrete connection parameters (used if DATABASE_URL is commented out)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=rowvane
# PGUSER=postgres
# PGPASSWORD=postgres
# PGSSLMODE=disable

# Connection Pool Settings
PGPOOL_MAX=10

# Dedicated Playground Database
# The isolated disposable database used for demonstrations and Chaos Mode.
# Destructive operations and 1-click resets are only permitted on this database.
PLAYGROUND_DATABASE=rowvane_playground

# Query Execution & Safety Guardrails
# Maximum execution time (in milliseconds) before a running SQL statement is cancelled
SQL_STATEMENT_TIMEOUT_MS=5000

# Maximum rows returned per statement in query results (prevents browser memory overflow)
SQL_QUERY_MAX_ROWS=1000

# Maximum row threshold for full CSV table exports before requiring filtered queries
SQL_EXPORT_MAX_ROWS=50000
